<UserControl x:Class="YMM4SystemFontChanger.Settings.FontChangerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DataContext="{d:DesignInstance Type=local:FontChangerSettings, IsDesignTimeCreatable=False}"
             xmlns:local="clr-namespace:YMM4SystemFontChanger.Settings">

    <StackPanel Margin="12" MinWidth="320">

        <TextBlock Text="System Font Changer"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />

        <TextBlock TextWrapping="Wrap"
                   Opacity="0.75"
                   Margin="0,0,0,12">
            YMM4本体のメニュー・ボタン・パネル・設定画面・タイムライン等、
            アプリケーション全体のUI表示フォントを変更します。
            （動画内のテキスト・字幕のフォント設定には影響しません）
        </TextBlock>

        <TextBlock Text="適用するフォント" Margin="0,0,0,4" />

        <ComboBox x:Name="FontComboBox"
                  ItemsSource="{Binding AvailableFontFamilyNames}"
                  SelectedItem="{Binding SelectedFontFamilyName, Mode=OneWay}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"
                  SelectionChanged="FontComboBox_SelectionChanged"
                  MinWidth="280"
                  HorizontalAlignment="Left" />

        <TextBlock Margin="0,6,0,0"
                   Opacity="0.6"
                   FontSize="11"
                   TextWrapping="Wrap">
            選択したフォントは即座にYMM4のUIへ反映され、次回起動時にも自動的に適用されます。
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ResetButton"
                    Content="デフォルトに戻す"
                    Padding="12,4"
                    Click="ResetButton_Click"
                    IsEnabled="{Binding IsCustomFontApplied}" />
        </StackPanel>

    </StackPanel>
</UserControl>
