<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- YMM4 v4.47以降は.NET10 + net10.0-windowsが必須 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YMM4SystemFontChanger</RootNamespace>
    <AssemblyName>YMM4SystemFontChanger</AssemblyName>

    <!-- プラグインDLL自体はYMM4本体が動的ロードするため、参照アセンブリのローカルコピーは最小限にする -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>AnyCPU</Platforms>
    <Version>1.0.0</Version>
    <Authors>YMM4 System Font Changer Contributors</Authors>
    <Product>YMM4 System Font Changer</Product>
    <Description>YukkuriMovieMaker4本体のUI表示フォントを変更するプラグインです。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      YMM4本体の公開プラグインAPI(YukkuriMovieMaker.Plugin.dll)のみを参照します。
      内部実装用DLL(YukkuriMovieMaker.exe本体やYukkuriMovieMaker.Controls.dllなど非公開の型)には依存しません。
      $(YMM4DirPath) は Directory.Build.props で定義してください。
    -->
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    ビルド後、YMM4のユーザープラグインフォルダに自動配置します。
    (YMM4フォルダ\user\plugin\ に配置されると「設定」→「プラグイン」に表示されます)
    YMM4DirPathが未設定の場合はスキップします。
  -->
  <Target Name="CopyToYmm4PluginFolder" AfterTargets="Build" Condition="'$(YMM4DirPath)' != ''">
    <MakeDir Directories="$(YMM4DirPath)user\plugin\" Condition="!Exists('$(YMM4DirPath)user\plugin\')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YMM4DirPath)user\plugin\" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(YMM4DirPath)user\plugin\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" ContinueOnError="true" />
  </Target>

</Project>
